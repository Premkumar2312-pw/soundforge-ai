# SoundForge AI - Environment Configuration Example
# Copy this file to .env for local overrides: cp .env.example .env

# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Provider Architecture ("procedural" or "mock")
PROVIDER=procedural

# Storage Provider Configuration ("local" or "s3")
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# S3 / MinIO Configuration (Optional - only required if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=your-s3-access-key-here
S3_SECRET_KEY=your-s3-secret-key-here
S3_BUCKET_NAME=soundforge-audio
S3_REGION=us-east-1

# Audio Delivery Standards (PS1 Compliance)
DEFAULT_SAMPLE_RATE=48000
DEFAULT_TARGET_LOUDNESS=-16.0
MAX_TRUE_PEAK_DBTP=-1.0
MIN_DURATION_SECONDS=5.0
MAX_DURATION_SECONDS=300.0
DURATION_TOLERANCE_SECONDS=0.05
LOUDNESS_TOLERANCE_LU=1.0

# Callback Webhook Signing Secret (HMAC-SHA256)
CALLBACK_SIGNING_SECRET=your-callback-signing-secret-key-here
